# NFC Type 2 file corpus: decode to the public JSON model, encode to actual
# binary output, and compare files (including NULL and Terminator bytes).
if(HAS_NFC)
    set(nfc_corpus "${CMAKE_CURRENT_LIST_DIR}/fixtures/nfc/type2")
    set(nfc_json "${CMAKE_CURRENT_BINARY_DIR}/nfc-type2.json")
    set(nfc_binary "${CMAKE_CURRENT_BINARY_DIR}/nfc-type2.bin")
    foreach(vector IN ITEMS sample empty-ndef controls short-254 extended-255 extended-256 framing-policy)
        check(0 "\"format\":\"nfc-type2\"" decode --format nfc-type2 --input "${nfc_corpus}/${vector}.bin")
        if(vector STREQUAL "sample")
            set(expected [=[{"schema":"opentlv.tlv","version":1,"format":"nfc-type2","elements":[{"tag":"00","value":""},{"tag":"03","value":"D101055402656E4869"},{"tag":"FE","value":""}]}]=])
            string(STRIP "${last_output}" actual)
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "Unexpected NFC sample model: ${actual}")
            endif()
        endif()
        file(WRITE "${nfc_json}" "${last_output}")
        check(0 "^$" encode --format nfc-type2 --input "${nfc_json}"
            --output-encoding binary --output-file "${nfc_binary}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
            "${nfc_corpus}/${vector}.bin" "${nfc_binary}" RESULT_VARIABLE different)
        if(NOT different EQUAL 0)
            message(FATAL_ERROR "NFC corpus round-trip mismatch: ${vector}")
        endif()
    endforeach()
    foreach(vector IN ITEMS nonminimal-extended reserved-length)
        check(1 "TLV_ERR_INVALID_LENGTH" decode --format nfc-type2 --input "${nfc_corpus}/invalid/${vector}.bin")
    endforeach()
    foreach(vector IN ITEMS missing-length truncated-extended truncated-value)
        check(1 "TLV_ERR_TRUNCATED" decode --format nfc-type2 --input "${nfc_corpus}/invalid/${vector}.bin")
    endforeach()
endif()
