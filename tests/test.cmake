# Definite BER nesting beyond the default uses caller-owned dynamic CLI storage.
if(HAS_BER)
    set(deep_wire "0400")
    foreach(level RANGE 1 96)
        string(LENGTH "${deep_wire}" hex_length)
        math(EXPR byte_length "${hex_length} / 2")
        math(EXPR length_hex "${byte_length}" OUTPUT_FORMAT HEXADECIMAL)
        string(SUBSTRING "${length_hex}" 2 -1 length_hex)
        string(LENGTH "${length_hex}" digits)
        if(digits EQUAL 1)
            set(length_hex "0${length_hex}")
        endif()
        if(byte_length GREATER 127)
            set(length_hex "81${length_hex}")
        endif()
        set(deep_wire "30${length_hex}${deep_wire}")
    endforeach()
    check(0 "" dump --format ber --hex "${deep_wire}" --tree --max-depth 96)
    check(3 "TLV_ERR_LIMIT" dump --format ber --hex "${deep_wire}" --tree --max-depth 95)
endif()
# Diagnostic paths retain the outermost 32 frames, visibly mark omitted frames,
# and unwind those frames before visiting a sibling (#550).
if(HAS_BER)
    function(wrap_diagnostic_sequence wire output)
        set(tag "30")
        if(ARGC GREATER 2)
            set(tag "${ARGV2}")
        endif()
        string(LENGTH "${wire}" hex_length)
        math(EXPR byte_length "${hex_length} / 2")
        math(EXPR length_hex "${byte_length}" OUTPUT_FORMAT HEXADECIMAL)
        string(SUBSTRING "${length_hex}" 2 -1 length_hex)
        string(LENGTH "${length_hex}" digits)
        math(EXPR odd "${digits} % 2")
        if(odd)
            set(length_hex "0${length_hex}")
        endif()
        if(byte_length GREATER 127)
            string(LENGTH "${length_hex}" digits)
            math(EXPR prefix "128 + ${digits} / 2" OUTPUT_FORMAT HEXADECIMAL)
            string(SUBSTRING "${prefix}" 2 -1 prefix)
            set(length_hex "${prefix}${length_hex}")
        endif()
        set(${output} "${tag}${length_hex}${wire}" PARENT_SCOPE)
    endfunction()
    set(invalid_nested "0401")
    set(valid_nested "0400")
    foreach(level RANGE 1 40)
        wrap_diagnostic_sequence("${invalid_nested}" invalid_nested)
        wrap_diagnostic_sequence("${valid_nested}" valid_nested)
    endforeach()
    string(REPEAT "30 > " 31 retained_path)
    string(APPEND retained_path "30 > ...")
    foreach(command IN ITEMS dump validate decode)
        check(1 "TLV_ERR_TRUNCATED" ${command} --format ber
            --hex "${invalid_nested}" --diagnostics json)
        string(JSON diagnostic_path GET "${last_error}" path)
        string(JSON omitted GET "${last_error}" path_omitted)
        if(NOT diagnostic_path STREQUAL retained_path OR NOT omitted EQUAL 8)
            message(FATAL_ERROR "Incomplete deep diagnostic path: ${last_error}")
        endif()
        check(1 "TLV_ERR_TRUNCATED" ${command} --format ber
            --hex "${invalid_nested}" --diagnostics human)
        string(FIND "${last_error}" "path: ${retained_path}\n" path_position)
        if(path_position EQUAL -1)
            message(FATAL_ERROR "Missing diagnostic truncation marker: ${last_error}")
        endif()
    endforeach()

    # Maximum-width BER identifiers plus the marker exceed 512 text bytes.
    set(long_tag "BF81818181818101")
    set(long_tag_wire "0401")
    foreach(level RANGE 1 33)
        wrap_diagnostic_sequence("${long_tag_wire}" long_tag_wire "${long_tag}")
    endforeach()
    string(REPEAT "${long_tag} > " 31 long_tag_path)
    string(APPEND long_tag_path "${long_tag} > ...")
    check(1 "TLV_ERR_TRUNCATED" validate --format ber
        --hex "${long_tag_wire}" --diagnostics json)
    string(JSON diagnostic_path GET "${last_error}" path)
    string(JSON omitted GET "${last_error}" path_omitted)
    if(NOT diagnostic_path STREQUAL long_tag_path OR NOT omitted EQUAL 1)
        message(FATAL_ERROR "Long diagnostic identifiers were lost: ${last_error}")
    endif()

    # Unwind to a shallow parent, exactly the storage boundary, and a still
    # truncated parent. Only the shared ancestors may survive the first branch.
    foreach(ancestor_depth IN ITEMS 1 31 35)
        set(sibling_wire "${valid_nested}0400A1020401")
        foreach(level RANGE 1 ${ancestor_depth})
            wrap_diagnostic_sequence("${sibling_wire}" sibling_wire)
        endforeach()
        check(1 "TLV_ERR_TRUNCATED" validate --format ber --max-depth 96
            --hex "${sibling_wire}" --diagnostics json)
        string(JSON diagnostic_path GET "${last_error}" path)
        if(ancestor_depth GREATER 31)
            string(JSON omitted GET "${last_error}" path_omitted)
            if(NOT diagnostic_path STREQUAL retained_path OR NOT omitted EQUAL 4)
                message(FATAL_ERROR "Truncated path did not unwind: ${last_error}")
            endif()
        else()
            string(REPEAT "30 > " ${ancestor_depth} expected_path)
            string(APPEND expected_path "A1")
            string(JSON omitted ERROR_VARIABLE no_omitted GET "${last_error}" path_omitted)
            if(NOT diagnostic_path STREQUAL expected_path OR NOT no_omitted)
                message(FATAL_ERROR "Deep diagnostic path did not unwind: ${last_error}")
            endif()
        endif()
    endforeach()
endif()
# Deterministic generator CLI: complete files, replay, bounds and round trips.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef generate_run)
set(generate_root "${CMAKE_CURRENT_BINARY_DIR}/generate-${generate_run}")
check(2 "requires --format" generate)
check(2 "seed/count" generate --format fixed --seed -1 --count 1 --output-dir "${generate_root}")
check(2 "seed/count" generate --format fixed --seed 18446744073709551616 --count 1 --output-dir "${generate_root}")
check(2 "positive" generate --format fixed --seed 0 --count 0 --output-dir "${generate_root}")
check(2 "positive" generate --format fixed --seed 0 --count 1 --max-depth 65 --output-dir "${generate_root}")
check(2 "not valid for generate" generate --format fixed --seed 0 --count 1 --hex 0100 --output-dir "${generate_root}")
check(2 "requires generate" dump --format fixed --seed 42 --hex 0100)
check(2 "duplicate option" generate --format fixed --seed 0 --seed 1 --count 1 --output-dir "${generate_root}")
check(3 "cannot generate case 0" generate --format fixed --seed 0 --count 1 --max-case-size 1 --output-dir "${generate_root}/impossible")
if(EXISTS "${generate_root}/impossible")
    message(FATAL_ERROR "Impossible generator configuration created output")
endif()
foreach(shell IN ITEMS bash zsh fish powershell)
    check(0 "generate" completion ${shell})
    check(0 "max-case-size" completion ${shell})
endforeach()
foreach(pair IN ITEMS "FIXED|fixed" "BER|ber" "DER|der" "EMV|emv" "BLUETOOTH_LTV|bluetooth-ltv" "NFC|nfc-type2")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 flag)
    list(GET parts 1 format)
    if(NOT HAS_${flag})
        check(2 "disabled format" generate --format "${format}" --seed 42 --count 1 --output-dir "${generate_root}/${format}")
        continue()
    endif()
    set(extra)
    if(format STREQUAL "fixed")
        set(extra --fixed-tag-size 3 --fixed-length-size 2 --fixed-byte-order little)
    endif()
    foreach(replay IN ITEMS a b)
        set(encoding_option)
        if(replay STREQUAL "b")
            set(encoding_option --output-encoding bin)
        endif()
        check(0 "^$" generate --format "${format}" ${extra} ${encoding_option}
            --seed 18446744073709551615 --count 12 --max-elements 10 --max-depth 3
            --max-value-size 32 --max-case-size 256 --output-dir "${generate_root}/${format}/${replay}")
        file(GLOB cases "${generate_root}/${format}/${replay}/*")
        list(LENGTH cases case_count)
        if(NOT case_count EQUAL 12)
            message(FATAL_ERROR "generate count did not produce exactly 12 binary files")
        endif()
    endforeach()
    check(0 "^$" generate --format "${format}" ${extra} --output-encoding json
        --seed 18446744073709551615 --count 12 --max-elements 10 --max-depth 3
        --max-value-size 32 --max-case-size 256 --output-dir "${generate_root}/${format}/json")
    file(GLOB json_cases "${generate_root}/${format}/json/*")
    list(LENGTH json_cases case_count)
    if(NOT case_count EQUAL 12)
        message(FATAL_ERROR "JSON generation did not produce exactly 12 files")
    endif()
    set(case_hashes)
    set(saw_children FALSE)
    foreach(index RANGE 0 11)
        string(LENGTH "${index}" digits)
        if(digits EQUAL 1)
            set(name "00000${index}.bin")
        else()
            set(name "0000${index}.bin")
        endif()
        set(case "${generate_root}/${format}/a/${name}")
        file(SIZE "${case}" bytes)
        if(bytes LESS 1 OR bytes GREATER 256)
            message(FATAL_ERROR "Generated case violates byte bound")
        endif()
        file(SHA256 "${case}" hash_a)
        list(APPEND case_hashes "${hash_a}")
        file(SHA256 "${generate_root}/${format}/b/${name}" hash_b)
        if(NOT hash_a STREQUAL hash_b)
            message(FATAL_ERROR "Generated replay differs for ${format}/${name}")
        endif()
        check(0 "^$" validate --format "${format}" ${extra} --input "${case}" --max-depth 3 --max-elements 10)
        check(0 "elements" decode --format "${format}" ${extra} --input "${case}")
        if(last_output MATCHES "children")
            set(saw_children TRUE)
        endif()
        string(REPLACE ".bin" ".json" sidecar_name "${name}")
        set(sidecar "${generate_root}/${format}/json/${sidecar_name}")
        file(READ "${sidecar}" sidecar_text)
        if(NOT sidecar_text STREQUAL last_output)
            message(FATAL_ERROR "JSON differs from decode for ${format}/${name}")
        endif()
        if(EXISTS "${generate_root}/${format}/b/${sidecar_name}")
            message(FATAL_ERROR "JSON emitted in binary mode")
        endif()
        check(0 "^$" encode --format "${format}" ${extra} --input "${sidecar}"
            --output-encoding binary --output-file "${generate_root}/roundtrip.bin")
        file(SHA256 "${generate_root}/roundtrip.bin" roundtrip)
        if(NOT hash_a STREQUAL roundtrip)
            message(FATAL_ERROR "Generated case did not round-trip: ${format}/${name}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES case_hashes)
    list(LENGTH case_hashes distinct_cases)
    if(distinct_cases LESS 2)
        message(FATAL_ERROR "Case indices did not vary generated cases")
    endif()
    if((format STREQUAL "ber" OR format STREQUAL "der" OR format STREQUAL "emv") AND NOT saw_children)
        message(FATAL_ERROR "Nested generation domain never produced children")
    endif()
    check(3 "refusing to overwrite" generate --format "${format}" ${extra} --seed 42 --count 13
        --output-dir "${generate_root}/${format}/a")
    if(EXISTS "${generate_root}/${format}/a/000012.bin")
        message(FATAL_ERROR "Collision preflight wrote an extra case")
    endif()
endforeach()
check(0 "^$" generate --format fixed --seed 0 --count 1 --max-value-size 0 --max-depth 0
    --output-dir "${generate_root}/empty-values")

file(WRITE "${generate_root}/not-a-directory" "sentinel")
check(3 "cannot create output directory" generate --format fixed --seed 0 --count 1
    --output-dir "${generate_root}/not-a-directory/child")
file(READ "${generate_root}/not-a-directory" sentinel)
if(NOT sentinel STREQUAL "sentinel")
    message(FATAL_ERROR "Directory failure changed unrelated content")
endif()

check(2 "bin or json" generate --format fixed --seed 0 --count 1 --output-dir "${generate_root}" --output-encoding hex)
check(2 "duplicate option" generate --format fixed --seed 0 --count 1
    --output-dir "${generate_root}" --output-encoding bin --output-encoding json)
file(MAKE_DIRECTORY "${generate_root}/json-collision")
file(WRITE "${generate_root}/json-collision/000001.json" "sentinel")
check(3 "refusing to overwrite case" generate --format fixed --seed 0 --count 2
    --output-dir "${generate_root}/json-collision" --output-encoding json)
if(EXISTS "${generate_root}/json-collision/000000.json" OR
   EXISTS "${generate_root}/json-collision/000000.bin")
    message(FATAL_ERROR "JSON collision preflight wrote a case")
endif()
file(READ "${generate_root}/json-collision/000001.json" sentinel)
if(NOT sentinel STREQUAL "sentinel")
    message(FATAL_ERROR "JSON collision changed existing content")
endif()
# An existing file of the unselected encoding is unrelated and retained.
check(0 "^$" generate --format fixed --seed 0 --count 2
    --output-dir "${generate_root}/json-collision" --output-encoding bin)
file(READ "${generate_root}/json-collision/000001.json" sentinel)
if(NOT sentinel STREQUAL "sentinel")
    message(FATAL_ERROR "Binary generation changed unrelated JSON")
endif()
