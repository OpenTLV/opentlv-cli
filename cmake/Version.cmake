# Only the CLI repository may supply version metadata, including in a superbuild.
function(opentlv_cli_version source output)
    set(_version "0.0.0+unknown")
    set(_sha "")
    set(_dirty "")
    execute_process(COMMAND git rev-parse --show-toplevel WORKING_DIRECTORY "${source}"
        OUTPUT_VARIABLE _root OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    file(REAL_PATH "${source}" _source)
    if(_root)
        file(REAL_PATH "${_root}" _root)
    endif()
    if(_root STREQUAL _source)
        execute_process(COMMAND git rev-parse --is-shallow-repository WORKING_DIRECTORY "${source}"
            OUTPUT_VARIABLE _shallow OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(_shallow STREQUAL "true")
            message(FATAL_ERROR "CLI versioning requires full Git history and tags; fetch --unshallow --tags")
        endif()
        execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${source}"
            OUTPUT_VARIABLE _sha RESULT_VARIABLE _sha_result OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        execute_process(COMMAND git status --porcelain WORKING_DIRECTORY "${source}"
            OUTPUT_VARIABLE _dirty RESULT_VARIABLE _status_result OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(NOT _sha_result EQUAL 0 OR NOT _status_result EQUAL 0)
            message(FATAL_ERROR "Cannot read CLI Git revision or worktree status")
        endif()
        execute_process(COMMAND git tag --points-at HEAD --list "v[0-9]*"
            WORKING_DIRECTORY "${source}" OUTPUT_VARIABLE _exact_tags
            OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(_exact_tags MATCHES "\n")
            message(FATAL_ERROR "Ambiguous CLI version: multiple version tags on one commit")
        endif()
        execute_process(COMMAND git describe --tags --abbrev=0 --match "v[0-9]*"
            WORKING_DIRECTORY "${source}" OUTPUT_VARIABLE _tag
            OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        set(_base "0.0.0")
        set(_range HEAD)
        if(_tag)
            string(SUBSTRING "${_tag}" 1 -1 _base)
            opentlv_cli_validate_version("${_base}")
            set(_range "${_tag}..HEAD")
        endif()
        execute_process(COMMAND git rev-list --count "${_range}" WORKING_DIRECTORY "${source}"
            OUTPUT_VARIABLE _count OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        string(SUBSTRING "${_sha}" 0 12 _short)
        if(_tag AND _count STREQUAL "0")
            set(_version "${_base}")
        else()
            if(_base MATCHES "-")
                set(_version "${_base}.dev.${_count}+g${_short}")
            else()
                set(_version "${_base}-dev.${_count}+g${_short}")
            endif()
        endif()
        if(_dirty)
            if(_version MATCHES "\\+")
                string(APPEND _version ".dirty")
            else()
                string(APPEND _version "+g${_short}.dirty")
            endif()
        endif()
    endif()
    # The release gate tests the future tag's version without creating any tag.
    if(OPENTLV_CLI_CANDIDATE_VERSION)
        opentlv_cli_validate_version("${OPENTLV_CLI_CANDIDATE_VERSION}")
        if(NOT _sha OR NOT OPENTLV_CLI_CANDIDATE_SHA STREQUAL _sha OR _dirty)
            message(FATAL_ERROR "Candidate version requires an exact CLI SHA and a clean CLI checkout")
        endif()
        set(_version "${OPENTLV_CLI_CANDIDATE_VERSION}")
    endif()
    set(${output} "${_version}" PARENT_SCOPE)
endfunction()

function(opentlv_cli_validate_version version)
    if(NOT version MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$")
        message(FATAL_ERROR "Invalid CLI Semantic Version: ${version}")
    endif()
    string(REGEX REPLACE "^[0-9]+\\.[0-9]+\\.[0-9]+-?" "" _pre "${version}")
    string(REPLACE "." ";" _identifiers "${_pre}")
    foreach(_identifier IN LISTS _identifiers)
        if(_identifier MATCHES "^0[0-9]+$")
            message(FATAL_ERROR "Invalid CLI numeric prerelease identifier: ${version}")
        endif()
    endforeach()
endfunction()
